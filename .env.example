# Backend Environment Variables Template
# Copy this file to .env and configure the appropriate values for your environment.

# Server Configuration
PORT=5001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=biotrack_hrm

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_KEY=12345678901234567890123456789012
INTERNAL_API_SECRET=your_internal_api_secret_key_here
KIOSK_API_KEY=your_kiosk_api_key_here

# Biometric Machine Network Configuration (Optional)
MACHINE_IP=192.168.1.201
MACHINE_PORT=4370

# Google Gemini AI Integration (HR Assistant)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Brevo / Transactional Email Service
BREVO_API_KEY=
MAIL_FROM_NAME=BioTrack Pro
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM=no-reply@example.com

# SMTP Email Settings (Fallback)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=BioTrack Pro

# Puppeteer PDF Generation (Optional custom chromium path)
PUPPETEER_EXECUTABLE_PATH=
